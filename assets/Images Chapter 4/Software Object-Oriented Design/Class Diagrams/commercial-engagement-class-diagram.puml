@startuml
title Commercial Engagement Bounded Context - Class Diagram
left to right direction
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

package "Commercial Engagement Bounded Context" #EAF3F8 {
  class CommercialInquiry <<Aggregate Root>> {
    -id : CommercialInquiryId
    -contact : ContactInformation
    -message : InquiryMessage
    -submittedAt : DateTimeOffset
    --
    +submit(contact, message, submittedAt)
  }

  class CommercialInquiryId <<Value Object>> {
    -value : Guid
  }

  class ContactInformation <<Value Object>> {
    -fullName : string
    -email : EmailAddress
    -phone : PhoneNumber?
    -companyName : string
  }

  class EmailAddress <<Value Object>> {
    -value : string
    +isValid() : bool
  }

  class PhoneNumber <<Value Object>> {
    -value : string
    +isValid() : bool
  }

  class InquiryMessage <<Value Object>> {
    -value : string
    +isBlank() : bool
  }

  interface CommercialInquiryRepository <<Repository>> {
    +save(inquiry : CommercialInquiry)
    +findById(id : CommercialInquiryId) : CommercialInquiry?
  }

  class PlanSummary <<Read Model>> {
    +name : string
    +priceLabel : string
    +features : List<string>
    +conditions : List<string>
  }

  class CommercialContentQueryService <<Query Service>> {
    +getPlanCatalog() : List<PlanSummary>
    +getValueProposition() : string
    +getFeatureCatalog() : List<string>
  }
}

CommercialInquiry *-- "1" CommercialInquiryId
CommercialInquiry *-- "1" ContactInformation
CommercialInquiry *-- "1" InquiryMessage
ContactInformation *-- "1" EmailAddress
ContactInformation o-- "0..1" PhoneNumber
CommercialInquiryRepository ..> CommercialInquiry : persists
CommercialContentQueryService ..> PlanSummary : returns
@enduml
